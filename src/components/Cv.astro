---
import {
  profile, ui, summary, approach, experience, achievements, projectGroups, grcCases, skills, education, languages, type Lang,
} from '../data/cv';
import { trackFileName, type Track } from '../data/cv-print';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (x: { en: string; id: string }) => x[lang];
const otherHref = lang === 'en' ? '/id/' : '/';
const otherLang = lang === 'en' ? 'id' : 'en';
const projectCount = projectGroups.reduce((n, g) => n + g.items.length, 0);

const sections = [
  { id: 'summary', label: t(ui.summary) },
  { id: 'approach', label: t(ui.approach) },
  { id: 'experience', label: t(ui.experience) },
  { id: 'achievements', label: t(ui.achievements) },
  { id: 'projects', label: t(ui.projects) },
  { id: 'grc', label: t(ui.grc) },
  { id: 'skills', label: t(ui.skills) },
  { id: 'education', label: t(ui.education) },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
const n = (id: string) => num(sections.findIndex((s) => s.id === id));

// Download dialog: step 1 language, step 2 CV type. Four ATS PDFs are built by scripts/build-pdf.mjs.
const fileName = (track: Track, l: Lang) => trackFileName(track, l);
const d = {
  title: { en: 'Download CV', id: 'Unduh CV' },
  intro: { en: 'Both CV types are ATS-friendly PDFs of up to 2 pages.', id: 'Kedua jenis CV berupa PDF ramah ATS, maksimal 2 halaman.' },
  step1: { en: 'Language', id: 'Bahasa' },
  step2: { en: 'CV type', id: 'Jenis CV' },
  qaTitle: { en: 'QA / Software Test Engineer', id: 'QA / Software Test Engineer' },
  qaDesc: { en: 'Testing, automation, API and performance, with 8 key projects.', id: 'Pengujian, otomasi, API, dan performa, dengan 8 proyek utama.' },
  grcTitle: { en: 'IT Governance, Risk and Compliance', id: 'IT Governance, Risk and Compliance' },
  grcDesc: { en: 'COBIT 2019, ISO/IEC 27001 and 27005, NIST CSF, with GRC case studies first.', id: 'COBIT 2019, ISO/IEC 27001 dan 27005, NIST CSF, dengan studi kasus GRC di bagian awal.' },
  file: { en: 'File', id: 'File' },
  cancel: { en: 'Cancel', id: 'Batal' },
  download: { en: 'Download PDF', id: 'Unduh PDF' },
  close: { en: 'Close', id: 'Tutup' },
};
---
<a class="skip" href="#main">{t(ui.skip)}</a>
<div class="page">
  <header class="aside">
    <div class="id-block">
      <h1 class="name">{profile.name}</h1>
      <p class="role">{t(profile.role)}</p>
      <p class="focus"><span class="focus-label">{t(ui.focusLabel)}</span> {t(profile.focus)}</p>
      <p class="member">{t(profile.membership)}</p>
      <p class="loc">{t(profile.location)}</p>
    </div>

    <ul class="contact" aria-label={t(ui.contact)}>
      <li><a class="tap" href={`mailto:${profile.email}`}>{profile.email}</a></li>
      <li class="phone-row">
        <a class="tap" href={profile.phoneHref}>{profile.phone}</a>
        <a class="tap wa" href={profile.whatsappHref} rel="noopener" target="_blank">WhatsApp</a>
      </li>
      <li><a class="tap" href={profile.linkedin} rel="me noopener">{profile.linkedinLabel}</a></li>
    </ul>

    <div class="actions">
      <a class="tap btn" href={otherHref} hreflang={otherLang} lang={otherLang}>{t(ui.langName)}</a>
      <button class="tap btn cv-open" type="button" aria-haspopup="dialog" aria-controls="cv-dialog">{t(ui.print)}</button>
      <button class="tap btn theme-toggle" type="button"
        data-label-light={t(ui.themeLight)} data-label-dark={t(ui.themeDark)}>
        <span class="theme-icon" aria-hidden="true"></span><span class="theme-text">{t(ui.themeDark)}</span>
      </button>
    </div>

    <nav class="toc" aria-label={lang === 'en' ? 'Sections' : 'Bagian'}>
      <ol>
        {sections.map((s, i) => (
          <li><a class="tap" href={`#${s.id}`}><span class="n">{num(i)}</span>{s.label}</a></li>
        ))}
      </ol>
    </nav>
  </header>

  <main id="main" class="main">
    <section id="summary" aria-labelledby="h-summary">
      <h2 id="h-summary"><span class="n">{n('summary')}</span>{t(ui.summary)}</h2>
      {summary.map((p) => <p class="lead">{t(p)}</p>)}
    </section>

    <section id="approach" aria-labelledby="h-approach">
      <h2 id="h-approach"><span class="n">{n('approach')}</span>{t(ui.approach)}</h2>
      <ol class="principles">
        {approach.map((a) => (
          <li>
            <h3>{t(a.title)}</h3>
            <p>{t(a.body)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="experience" aria-labelledby="h-experience">
      <h2 id="h-experience"><span class="n">{n('experience')}</span>{t(ui.experience)}</h2>
      <article class="job">
        <div class="job-head">
          <h3>{t(experience.title)}</h3>
          <p class="meta">
            <span>{experience.company}</span>
            <span>{t(experience.period.from)} – {t(ui.present)} · {t(experience.place)}</span>
          </p>
        </div>
        <ul class="bullets">
          {experience.bullets.map((b) => <li>{t(b)}</li>)}
        </ul>
      </article>
    </section>

    <section id="achievements" aria-labelledby="h-achievements">
      <h2 id="h-achievements"><span class="n">{n('achievements')}</span>{t(ui.achievements)}</h2>
      <ul class="awards">
        {achievements.map((a) => (
          <li>
            <p class="year">{t(a.date)}</p>
            <div>
              <h3>{t(a.title)}</h3>
              <p class="client">{t(a.event)}</p>
              <p class="detail">{t(a.detail)}</p>
              {a.link && (
                <p class="ext"><a class="tap" href={a.link.href} rel="noopener" target="_blank">{t(a.link.label)} ↗</a></p>
              )}
              {a.photos && (
                <ul class="photos">
                  {a.photos.map((p) => (
                    <li>
                      <a href={`/img/${p.base}-1600.webp`} target="_blank" rel="noopener">
                        <img
                          src={`/img/${p.base}-800.webp`}
                          srcset={`/img/${p.base}-800.webp 800w, /img/${p.base}-1600.webp 1600w`}
                          sizes="(min-width: 960px) 330px, (min-width: 480px) 45vw, 100vw"
                          width={p.w} height={p.h}
                          style={p.pos ? `object-position: ${p.pos}` : undefined}
                          alt={t(p.alt)}
                          loading="lazy" decoding="async"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="projects" aria-labelledby="h-projects">
      <h2 id="h-projects"><span class="n">{n('projects')}</span>{t(ui.projects)}</h2>
      <p class="intro">{t(ui.projectsIntro).replace('17', String(projectCount))}</p>
      {projectGroups.map((g) => (
        <div class="group">
          <h3 class="group-title">{t(g.domain)}</h3>
          <ul class="ledger">
            {g.items.map((p) => (
              <li class="row">
                <div class="row-head">
                  <h4>{p.name}</h4>
                  <p class="client">{t(p.client)}</p>
                  {p.ongoing && <p class="status">{t(ui.ongoing)}</p>}
                </div>
                <div class="row-body">
                  <p>{t(p.body)}</p>
                  <ul class="tags" aria-label={lang === 'en' ? 'Testing types' : 'Jenis pengujian'}>
                    {p.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section id="grc" aria-labelledby="h-grc">
      <h2 id="h-grc"><span class="n">{n('grc')}</span>{t(ui.grc)}</h2>
      <p class="intro">{t(ui.grcIntro)}</p>
      <ul class="ledger">
        {grcCases.map((c) => (
          <li class="row case">
            <div class="row-head">
              <h3 class="case-title">{t(c.title)}</h3>
              <p class="client">{t(c.context)}</p>
            </div>
            <div class="row-body">
              <ul class="bullets tight">
                {c.bullets.map((b) => <li>{t(b)}</li>)}
              </ul>
              <ul class="tags" aria-label="Frameworks">
                {c.framework.split(' · ').map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="skills" aria-labelledby="h-skills">
      <h2 id="h-skills"><span class="n">{n('skills')}</span>{t(ui.skills)}</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{t(s.group)}</dt>
            <dd>{s.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="education" aria-labelledby="h-education">
      <h2 id="h-education"><span class="n">{n('education')}</span>{t(ui.education)}</h2>
      <ul class="edu">
        {education.map((e) => (
          <li>
            <h3>{t(e.degree)}</h3>
            <p class="meta"><span>{e.school}</span><span>{t(e.period)}</span></p>
            {e.note && <p class="note">{t(e.note)}</p>}
          </li>
        ))}
      </ul>
      <h3 class="sub">{t(ui.languages)}</h3>
      <p>{languages.map((l) => t(l)).join(' · ')}</p>
    </section>

    <footer class="foot">
      <p>{t(ui.footer)}</p>
      <noscript>
        <p class="cv-fallback">{t(d.title)}:
          <a href={`/cv/${fileName('qa', 'en')}`} download>QA EN</a> ·
          <a href={`/cv/${fileName('qa', 'id')}`} download>QA ID</a> ·
          <a href={`/cv/${fileName('grc', 'en')}`} download>GRC EN</a> ·
          <a href={`/cv/${fileName('grc', 'id')}`} download>GRC ID</a>
        </p>
      </noscript>
    </footer>
  </main>
</div>

<dialog id="cv-dialog" class="cv-dialog" aria-labelledby="cvd-title" aria-describedby="cvd-intro">
  <form method="dialog" class="cvd-form">
    <div class="cvd-head">
      <h2 id="cvd-title">{t(d.title)}</h2>
      <button class="tap cvd-x" value="cancel" aria-label={t(d.close)}>×</button>
    </div>
    <p id="cvd-intro" class="cvd-intro">{t(d.intro)}</p>

    <fieldset>
      <legend><span class="cvd-step">1</span>{t(d.step1)}</legend>
      <div class="cvd-row">
        <label class="cvd-opt tap"><input type="radio" name="cv-lang" value="en" checked={lang === 'en'} /> English</label>
        <label class="cvd-opt tap"><input type="radio" name="cv-lang" value="id" checked={lang === 'id'} /> Bahasa Indonesia</label>
      </div>
    </fieldset>

    <fieldset>
      <legend><span class="cvd-step">2</span>{t(d.step2)}</legend>
      <label class="cvd-opt cvd-card tap">
        <input type="radio" name="cv-track" value="qa" checked />
        <span><strong>{t(d.qaTitle)}</strong><small>{t(d.qaDesc)}</small></span>
      </label>
      <label class="cvd-opt cvd-card tap">
        <input type="radio" name="cv-track" value="grc" />
        <span><strong>{t(d.grcTitle)}</strong><small>{t(d.grcDesc)}</small></span>
      </label>
    </fieldset>

    <p class="cvd-file" aria-live="polite">{t(d.file)}: <code class="cvd-name">{fileName('qa', lang)}</code></p>

    <div class="cvd-actions">
      <button class="tap btn" value="cancel">{t(d.cancel)}</button>
      <a class="tap btn btn-primary cvd-download" href={`/cv/${fileName('qa', lang)}`} download type="application/pdf">{t(d.download)}</a>
    </div>
  </form>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('cv-dialog');
    var openBtn = document.querySelector('.cv-open');
    if (!dlg || !openBtn || typeof dlg.showModal !== 'function') return;
    var link = dlg.querySelector('.cvd-download');
    var nameEl = dlg.querySelector('.cvd-name');
    function pick(name) { var el = dlg.querySelector('input[name="' + name + '"]:checked'); return el ? el.value : ''; }
    function update() {
      var file = 'Rifki-Hidayatullah-CV-' + pick('cv-track').toUpperCase() + '-' + pick('cv-lang').toUpperCase() + '.pdf';
      link.href = '/cv/' + file;
      nameEl.textContent = file;
    }
    dlg.addEventListener('change', update);
    openBtn.addEventListener('click', function () { update(); dlg.showModal(); });
    // Close when the backdrop is clicked.
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    // Let the download start, then close.
    link.addEventListener('click', function () { setTimeout(function () { dlg.close(); }, 0); });
    dlg.addEventListener('close', function () { openBtn.focus(); });
  })();
</script>
