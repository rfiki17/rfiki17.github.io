---
// v2 layout in the style of the 19 Sep 2026 site, with the current CV content.
import {
  profile, ui, experience, achievements, projectGroups, grcCases, skills, education, languages, type Lang,
} from '../data/cv';
import {
  availability, phrases, tagline, heroIntro, aboutStatement, aboutCols, whatIDo, research, leadership,
  certHighlights, certGroups, certUi, contactStatement, messages, nav, ui2, rail, heroStats, views, ui3, availabilityCard, ui4,
} from '../data/v2';
import DownloadDialog from './DownloadDialog.astro';
import ShareDialog from './ShareDialog.astro';
import { caseStudies, caseUi } from '../data/cases';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (x: { en: string; id: string }) => x[lang];
const otherHref = lang === 'en' ? '/id/' : '/';
const otherLang = lang === 'en' ? 'id' : 'en';
const projectCount = projectGroups.reduce((n, g) => n + g.items.length, 0);
const awards = achievements.filter((a) => a.group !== 'leadership');
const idlsLead = achievements.find((a) => a.group === 'leadership');
const m = messages[lang];
const mailHref = `mailto:${profile.email}?subject=${encodeURIComponent(m.subject)}&body=${encodeURIComponent(m.body)}`;
const waHref = `${profile.whatsappHref}?text=${encodeURIComponent(m.wa)}`;
const nameParts = profile.name.split(' ');
const featured = projectGroups.flatMap((g) => g.items.filter((p) => p.featured).map((p) => ({ ...p, domain: g.domain })));
const restGroups = projectGroups.map((g) => ({ ...g, items: g.items.filter((p) => !p.featured) })).filter((g) => g.items.length);
const restCount = restGroups.reduce((n, g) => n + g.items.length, 0);
const caseFor = (name: string, client: { en: string }) => caseStudies.find((c) => c.project === name && c.projectClient === client.en);
const caseBase = lang === 'en' ? '/case-studies/' : '/id/case-studies/';
const shareIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M8 8l4-4 4 4" /><path d="M5 12v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>';
// Build date for the footer, so "Updated" never goes stale.
const updatedOn = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'id-ID', { month: 'long', year: 'numeric' }).format(new Date());
const stats = [
  { value: heroStats.years.value, label: t(heroStats.years.label) },
  { value: String(projectCount), label: t(heroStats.systems.label) },
  { value: heroStats.gama.value, label: t(heroStats.gama.label) },
  { value: String(grcCases.length), label: t(heroStats.grc.label) },
];
---
<a class="skip" href="#main">{t(ui.skip)}</a>
<div class="wrap">
  <header class="top" id="top">
    <a class="brand" href="#main">{profile.name}</a>
    <nav aria-label={lang === 'en' ? 'Main' : 'Utama'}>
      <a href="#about">{t(nav.about)}</a>
      <a href="#achievements">{t(nav.achievements)}</a>
      <a href="#experience">{t(nav.experience)}</a>
      <a href="#work">{t(nav.work)}</a>
      <a href="#contact">{t(nav.contact)}</a>
    </nav>
    <div class="tools">
      <a class="chip tap" href={otherHref} hreflang={otherLang} lang={otherLang}>{otherLang.toUpperCase()}<span class="sr"> {t(ui2.switchLang)}</span></a>
      <button class="chip tap theme-toggle" type="button" data-label-light={t(ui.themeLight)} data-label-dark={t(ui.themeDark)}>
        <span class="theme-text">{t(ui.themeDark)}</span>
      </button>
      <button class="chip tap share-open share-top" type="button" aria-haspopup="dialog" aria-controls="share-dialog"><Fragment set:html={shareIcon} /><span class="share-lbl">{t(ui3.share)}</span></button>
      <button class="chip tap cv-open" type="button" aria-haspopup="dialog" aria-controls="cv-dialog">{t(ui2.download)}</button>
    </div>
  </header>

  <nav class="rail" data-spy aria-label={t(ui2.sections)}>
    <ol>
      {rail.map((r) => (
        <li class={`nav-${r.id}`}><a class="tap" href={`#${r.id}`}>{lang === 'en' ? r.en : r.id_}</a></li>
      ))}
    </ol>
  </nav>

  <main id="main">
    <section class="hero" aria-labelledby="name">
      <p class="avail"><a href="#availability"><span class="avail-dot" aria-hidden="true"></span>{t(availabilityCard.heroLine)}</a></p>
      <h1 class="name" id="name">
        <span class="line"><span>{nameParts[0]}</span></span>
        <span class="line"><span>{nameParts.slice(1).join(' ')}</span></span>
      </h1>
      <p class="typed" aria-hidden="true"><span id="typedText">{phrases[lang][0]}</span><span class="caret"></span></p>
      <p class="sr">{t(tagline)}</p>
      <div class="hero-row">
        <div>
          <p class="intro">{t(heroIntro)}</p>
          <p class="hero-tags"><span>{t(profile.role)}</span><span>{t(profile.focus)}</span><span>{t(profile.membership)}</span></p>
        </div>
        <div class="hero-side">
          <fieldset class="views">
            <legend>{t(ui3.viewAs)}</legend>
            <div class="views-row">
              {views.map((v) => (
                <label class="chip tap view-opt"><input type="radio" name="view" value={v.id} checked={v.id === 'all'} /><span>{t(v.label)}</span></label>
              ))}
            </div>
            <p class="views-hint">{t(ui3.viewHint)}</p>
          </fieldset>
          <dl class="stats" aria-label={t(ui2.stats)}>
            {stats.map((st) => (
              <div class="stat"><dt>{st.value}</dt><dd>{st.label}</dd></div>
            ))}
          </dl>
          <a class="link" href="#work">{t(ui2.seeWork)}</a>
        </div>
      </div>
    </section>

    <section class="s" id="about" aria-labelledby="h-about">
      <h2 class="reveal" id="h-about">{t(nav.about)}</h2>
      <div class="about-grid">
        <figure class="portrait reveal">
          <img src="/img/portrait-600.webp" srcset="/img/portrait-600.webp 600w, /img/portrait-1000.webp 1000w"
            sizes="(min-width: 900px) 300px, 260px" width="1000" height="1250" loading="lazy" decoding="async"
            alt={t(ui2.portraitAlt)} />
        </figure>
        <div>
          <p class="statement reveal">{t(aboutStatement)}</p>
          <div class="cols reveal">
            {aboutCols.map((c) => <p set:html={t(c)} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="s" id="achievements" aria-labelledby="h-achievements">
      <h2 class="reveal" id="h-achievements">{t(nav.achievements)}</h2>
      <div class="list reveal">
        {awards.map((a) => (
          <article class="item award">
            <div class="meta">{t(a.date)}</div>
            <div>
              <h3>{t(a.title)}</h3>
              <p class="event">{t(a.event)}</p>
              <p>{t(a.detail)}</p>
              {a.link && <p><a class="link small" href={a.link.href} rel="noopener" target="_blank">{t(a.link.label)}</a></p>}
              {a.photos && (
                <div class="shots">
                  {a.photos.map((p) => (
                    <figure class="shot">
                      <a href={`/img/${p.base}-1600.webp`} target="_blank" rel="noopener" data-lightbox="photos">
                        <img
                          src={`/img/${p.base}-800.webp`}
                          srcset={`/img/${p.base}-800.webp 800w, /img/${p.base}-1600.webp 1600w`}
                          sizes="(min-width: 900px) 340px, 90vw"
                          width={p.w} height={p.h} alt={t(p.alt)} loading="lazy" decoding="async"
                          style={p.pos ? `object-position: ${p.pos}` : undefined}
                        />
                      </a>
                    </figure>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="s" id="do" aria-labelledby="h-do">
      <h2 class="reveal" id="h-do">{t(ui2.whatIDo)}</h2>
      <div class="trio reveal">
        {whatIDo.map((w) => (
          <div>
            <h3>{t(w.title)}</h3>
            <p>{t(w.body)}</p>
            <p class="stack">{w.stack}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="s" id="experience" aria-labelledby="h-experience">
      <h2 class="reveal" id="h-experience">{t(nav.experience)}</h2>
      <div class="list reveal">
        <article class="item">
          <div class="meta">{experience.company}<br />{t(experience.period.from)} – {t(ui.present)}<br />{t(experience.place)}</div>
          <div>
            <h3>{t(experience.title)}</h3>
            <ul>{experience.bullets.map((b) => <li>{t(b)}</li>)}</ul>
            <p class="stack">Playwright, TypeScript, Postman, JMeter, SQL, Jira, Kiwi TCMS</p>
          </div>
        </article>
      </div>
    </section>

    <section class="s" id="work" aria-labelledby="h-work">
      <h2 class="reveal" id="h-work">{t(ui2.work)}</h2>
      <p class="statement reveal">{t(ui.projectsIntro).replace('17', String(projectCount))}</p>
      <div class="list reveal featured">
        {featured.map((p) => {
          const cs = caseFor(p.name, p.client);
          return (
          <article class="item project">
            <div class="meta">{t(p.client)}<span class="domain">{t(p.domain)}</span>{p.ongoing && <span class="badge">{t(ui.ongoing)}</span>}</div>
            <div>
              <h3>{p.name}</h3>
              <p>{t(p.body)}</p>
              <p class="stack">{p.tags.join(', ')}</p>
              {cs && <p><a class="link small case-link" href={`${caseBase}${cs.slug}/`}>{t(caseUi.read)} &rarr;</a></p>}
            </div>
          </article>
          );
        })}
      </div>
      <details class="more-projects">
        <summary class="chip tap">{t(ui3.moreProjects).replace('{n}', String(restCount))}</summary>
        {restGroups.map((g) => (
          <div class="group">
            <h3 class="group-title">{t(g.domain)}</h3>
            <div class="list">
              {g.items.map((p) => (
                <article class="item project">
                  <div class="meta">{t(p.client)}{p.ongoing && <span class="badge">{t(ui.ongoing)}</span>}</div>
                  <div>
                    <h3>{p.name}</h3>
                    <p>{t(p.body)}</p>
                    <p class="stack">{p.tags.join(', ')}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </details>
    </section>

    <section class="s" id="research" aria-labelledby="h-research">
      <h2 class="reveal" id="h-research">{t(ui2.research)}</h2>
      <div class="list reveal">
        {research.map((r) => (
          <article class="item">
            <div class="meta">{t(r.meta)}</div>
            <div>
              <h3>{t(r.title)}</h3>
              <p>{t(r.body)}</p>
              <p class="stack">{r.stack}</p>
            </div>
          </article>
        ))}
        {grcCases.map((c) => (
          <article class="item grc-case">
            <div class="meta">{t(c.context)}</div>
            <div>
              <h3>{t(c.title)}</h3>
              <ul>{c.bullets.map((b) => <li>{t(b)}</li>)}</ul>
              <p class="stack">{c.framework.replaceAll(' · ', ', ')}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="note reveal grc-note">{t(ui.grcIntro)}</p>
    </section>

    <section class="s" id="leadership" aria-labelledby="h-leadership">
      <h2 class="reveal" id="h-leadership">{t(ui2.leadership)}</h2>
      <div class="list reveal">
        {idlsLead && (
          <article class="item">
            <div class="meta">Indonesia Digital Leadership Summit, 2026</div>
            <div>
              <h3>{t(idlsLead.title)}</h3>
              <p>{t(idlsLead.detail)}</p>
              {idlsLead.link && <p><a class="link small" href={idlsLead.link.href} rel="noopener" target="_blank">{t(idlsLead.link.label)}</a></p>}
            </div>
          </article>
        )}
        {leadership.map((l) => (
          <article class="item">
            <div class="meta">{t(l.meta)}</div>
            <div>
              <h3>{t(l.title)}</h3>
              <p>{t(l.body)}</p>
              {l.links && (
                <ul class="links">
                  {l.links.map((k) => <li><a class="link small" href={k.href} rel="noopener" target="_blank">{t(k.label)}</a></li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="s" id="certs" aria-labelledby="h-certs">
      <h2 class="reveal" id="h-certs">{t(certUi.heading)}</h2>
      <div class="certs reveal">
        {certHighlights.map((c) => (
          <article class="cert">
            <div class="meta">{t(c.date)}</div>
            <h3>{t(c.title)}</h3>
            <p class="event">{t(c.issuer)}</p>
            {c.detail && <p>{t(c.detail)}</p>}
            {c.number && <p class="cert-no"><span>{t(ui4.certNo)}</span> {c.number}</p>}
            {(c.verify || c.images) && (
              <p class="cert-proof">
                {c.verify && <a class="link small" href={c.verify} target="_blank" rel="noopener">{t(ui4.verify)}</a>}
                {c.images && c.images.map((im, i) => (
                  <a class="link small" href={`/img/${im.base}-1600.webp`} target="_blank" rel="noopener"
                    data-lightbox={`cert-${c.images![0].base}`} data-alt={t(im.alt)} hidden={i > 0}>
                    {c.images!.length > 1 ? t(ui4.viewCerts).replace('{n}', String(c.images!.length)) : t(ui4.viewCert)}
                  </a>
                ))}
              </p>
            )}
          </article>
        ))}
      </div>
      <div class="list reveal">
        {certGroups.map((g) => (
          <article class="item">
            <div class="meta">{t(g.meta)}</div>
            <div>
              {g.toggle ? (
                <>
                  <p>{t(g.summary)}.</p>
                  <details class="more-certs">
                    <summary class="link small">{t(g.toggle)}</summary>
                    <ul>
                      {g.items.map((c) => <li><span class="when">{t(c.date)}</span> {c.title}</li>)}
                    </ul>
                  </details>
                </>
              ) : (
                g.items.map((c) => (
                  <>
                    <h3>{c.title}</h3>
                    <p>{t(g.summary)} · {t(c.date)}</p>
                  </>
                ))
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="s" id="education" aria-labelledby="h-education">
      <h2 class="reveal" id="h-education">{t(ui.education)}</h2>
      <div class="list reveal">
        {education.map((e) => (
          <article class="item">
            <div class="meta">{e.school}</div>
            <div>
              <h3>{t(e.degree)}</h3>
              <p>{t(e.period)}{e.note ? ` · ${t(e.note)}` : ''}</p>
            </div>
          </article>
        ))}
        <article class="item">
          <div class="meta">{t(ui.languages)}</div>
          <div><p>{languages.map((l) => t(l)).join(' · ')}</p></div>
        </article>
      </div>
    </section>

    <section class="s" id="skills" aria-labelledby="h-skills">
      <h2 class="reveal" id="h-skills">{t(ui.skills)}</h2>
      <div class="list reveal">
        {skills.map((s) => (
          <div class="item skill">
            <div class="meta">{t(s.group)}</div>
            <div><p>{s.items}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="s" id="contact" aria-labelledby="h-contact">
      <h2 class="reveal" id="h-contact">{t(nav.contact)}</h2>
      <div class="reveal">
        <p class="statement">{t(contactStatement)}</p>
        <section class="avail-card" id="availability" aria-labelledby="h-avail">
          <div class="avail-head">
            <h3 id="h-avail">{t(availabilityCard.title)}</h3>
            <span class="avail-status"><span class="avail-dot" aria-hidden="true"></span>{t(availabilityCard.status)}</span>
          </div>
          <dl>
            {availabilityCard.rows.map((r) => (
              <div><dt>{t(r.label)}</dt><dd>{t(r.value)}</dd></div>
            ))}
          </dl>
        </section>
        <ul class="contact-list">
          <li>
            <span>Email</span>
            <span class="val">
              <a class="tap" href={mailHref}>{profile.email}</a>
              <button class="copy tap" type="button" data-copy={profile.email} data-done={t(ui2.copied)}>{t(ui2.copy)}</button>
            </span>
          </li>
          <li>
            <span>WhatsApp</span>
            <span class="val"><a class="tap" href={waHref} rel="noopener" target="_blank">{profile.phone}</a></span>
          </li>
          <li>
            <span>LinkedIn</span>
            <span class="val"><a class="tap" href={profile.linkedin} rel="me noopener" target="_blank">linkedin.com/in/rifki-hidayatullah</a></span>
          </li>
          <li>
            <span>{t(ui3.contactCard)}</span>
            <span class="val"><a class="tap" href="/rifki-hidayatullah.vcf" download>{t(ui3.saveContact)}</a></span>
          </li>
          <li>
            <span>{t(ui3.share)}</span>
            <span class="val"><button class="chip tap share-open" type="button" aria-haspopup="dialog" aria-controls="share-dialog"><Fragment set:html={shareIcon} />{t(ui3.share)}</button></span>
          </li>
          <li>
            <span>CV</span>
            <span class="val"><button class="chip tap cv-open" type="button" aria-haspopup="dialog" aria-controls="cv-dialog">{t(ui2.download)}</button></span>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer>
    <span>{profile.name}, {t(profile.location).split(',')[0]}</span>
    <span>{t(ui2.updated)} {updatedOn}</span>
  </footer>
</div>

<div class="minibar">
  <div class="wrap minibar-in">
    <a class="brand" href="#top">{profile.name}</a>
    <div class="minibar-tools">
      <button class="chip tap share-open share-icon" type="button" aria-haspopup="dialog" aria-controls="share-dialog" aria-label={t(ui3.share)}><Fragment set:html={shareIcon} /></button>
      <button class="chip tap sheet-open" type="button" aria-haspopup="dialog" aria-controls="sections-sheet">{t(ui2.openSections)}</button>
      <button class="chip chip-solid tap cv-open" type="button" aria-haspopup="dialog" aria-controls="cv-dialog">{t(ui2.download)}</button>
    </div>
  </div>
</div>

<dialog id="sections-sheet" class="sheet" aria-labelledby="sheet-title">
  <div class="sheet-head">
    <h2 id="sheet-title">{t(ui2.openSections)}</h2>
    <button class="cvd-x tap sheet-close" type="button" aria-label={t(ui2.close)}>&times;</button>
  </div>
  <nav aria-labelledby="sheet-title" data-spy>
    <ol>
      {rail.map((r) => (
        <li class={`nav-${r.id}`}><a class="tap" href={`#${r.id}`}>{lang === 'en' ? r.en : r.id_}</a></li>
      ))}
    </ol>
  </nav>
</dialog>

<a class="to-top tap" href="#top" aria-label={t(ui2.toTop)}><span aria-hidden="true">&uarr;</span></a>

<DownloadDialog lang={lang} />
<ShareDialog lang={lang} />

<dialog id="lightbox" class="lightbox" aria-label={t(ui3.photo)}>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-btn lb-prev tap" type="button" aria-label={t(ui3.prev)}>&lsaquo;</button>
  <button class="lb-btn lb-next tap" type="button" aria-label={t(ui3.next)}>&rsaquo;</button>
  <button class="lb-btn lb-close tap" type="button" aria-label={t(ui2.close)}>&times;</button>
</dialog>

<script is:inline define:vars={{ list: phrases[lang] }}>
  (function () {
    var root = document.documentElement;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Name reveal and section reveal. Without JS or with reduced motion everything is shown at once.
    root.classList.add('js');
    requestAnimationFrame(function () { root.classList.add('loaded'); });
    var items = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('in'); });
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      items.forEach(function (el) { io.observe(el); });
    }

    // Typing line. Reduced motion keeps the first phrase static.
    var el = document.getElementById('typedText');
    if (el && !reduce) {
      var i = 0, pos = list[0].length, deleting = true;
      var tick = function () {
        var word = list[i];
        if (deleting) {
          pos--; el.textContent = word.slice(0, pos);
          if (pos <= 0) { deleting = false; i = (i + 1) % list.length; }
          setTimeout(tick, 28);
        } else {
          word = list[i]; pos++; el.textContent = word.slice(0, pos);
          if (pos >= word.length) { deleting = true; setTimeout(tick, 2400); } else { setTimeout(tick, 55); }
        }
      };
      setTimeout(tick, 2600);
    }

    // Copy email.
    document.querySelectorAll('.copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy');
        var old = btn.textContent;
        var done = function () { btn.textContent = btn.getAttribute('data-done'); setTimeout(function () { btn.textContent = old; }, 1600); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done).catch(function () {});
      });
    });

    // Section menu on the right: marks the section being read (aria-current). A clicked link
    // stays marked until the visitor scrolls again, so a short section near the end (Skills)
    // is not overruled by the last one.
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-spy] a[href^="#"]'));
    var secs = links.map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); }).filter(Boolean);
    var toTop = document.querySelector('.to-top');
    var minibar = document.querySelector('.minibar');
    var hero = document.querySelector('.hero');

    // Sections sheet (below 1200 px): all sections in a modal dialog.
    var sheet = document.getElementById('sections-sheet');
    var sheetBtn = document.querySelector('.sheet-open');
    if (sheet && sheetBtn && typeof sheet.showModal === 'function') {
      sheetBtn.addEventListener('click', function () { sheet.showModal(); });
      sheet.querySelector('.sheet-close').addEventListener('click', function () { sheet.close(); });
      sheet.addEventListener('click', function (e) { if (e.target === sheet) sheet.close(); });
      sheet.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { sheet.close(); }); });
    }
    var pinned = null, ticking = false;
    var setActive = function (id) {
      links.forEach(function (a) {
        if (id && a.getAttribute('href') === '#' + id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    var compute = function () {
      ticking = false;
      if (toTop) toTop.classList.toggle('show', window.scrollY > window.innerHeight * 0.8);
      if (minibar && hero) {
        var past = hero.getBoundingClientRect().bottom < 0;
        minibar.classList.toggle('show', past);
        minibar.inert = !past;
      }
      if (pinned || !secs.length) return;
      var line = window.innerHeight * 0.3, cur = null;
      secs.forEach(function (s) { if (s.getBoundingClientRect().top <= line) cur = s.id; });
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) cur = secs[secs.length - 1].id;
      setActive(cur);
    };
    var unpin = function () { if (pinned) { pinned = null; compute(); } };
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(compute); } }, { passive: true });
    window.addEventListener('resize', compute);
    ['wheel', 'touchstart', 'keydown'].forEach(function (ev) { window.addEventListener(ev, unpin, { passive: true }); });
    links.forEach(function (a) {
      a.addEventListener('click', function () { pinned = a.getAttribute('href').slice(1); setActive(pinned); });
    });
    var hash = location.hash.slice(1);
    if (hash && secs.some(function (s) { return s.id === hash; })) { pinned = hash; setActive(hash); }
    compute();

    // View switch: all, QA or IT GRC. The head script in Base.astro applies the saved or linked view
    // before first paint. Here the radios follow it and change it.
    var radios = document.querySelectorAll('.views input[name="view"]');
    var setView = function (v) {
      root.setAttribute('data-view', v);
      try { localStorage.setItem('view', v); } catch (e) {}
      var url = new URL(location.href);
      if (v === 'all') url.searchParams.delete('view'); else url.searchParams.set('view', v);
      history.replaceState(null, '', url);
      compute();
    };
    radios.forEach(function (r) {
      r.checked = r.value === (root.getAttribute('data-view') || 'all');
      r.addEventListener('change', function () { if (r.checked) setView(r.value); });
    });

    // Projects behind "Show more" and other collapsed lists print in full.
    window.addEventListener('beforeprint', function () {
      document.querySelectorAll('details').forEach(function (d) { d.setAttribute('data-was', d.open ? '1' : ''); d.open = true; });
    });
    window.addEventListener('afterprint', function () {
      document.querySelectorAll('details[data-was]').forEach(function (d) { d.open = d.getAttribute('data-was') === '1'; d.removeAttribute('data-was'); });
    });

    // Photo viewer. Without JS the photo links still open the full image.
    var lb = document.getElementById('lightbox');
    // Links with data-lightbox open here. Links that share a data-lightbox value form one gallery.
    var shots = Array.prototype.slice.call(document.querySelectorAll('a[data-lightbox]'));
    if (lb && shots.length && typeof lb.showModal === 'function') {
      var lbImg = lb.querySelector('img'), lbCap = lb.querySelector('figcaption'), lbIdx = 0, lbOpener = null, group = shots;
      var navBtns = lb.querySelectorAll('.lb-prev, .lb-next');
      var show = function (i) {
        lbIdx = (i + group.length) % group.length;
        var a = group[lbIdx], thumb = a.querySelector('img');
        var alt = a.getAttribute('data-alt') || (thumb ? thumb.alt : '');
        lbImg.src = a.getAttribute('href');
        lbImg.alt = alt;
        lbCap.textContent = group.length > 1 ? alt + ' (' + (lbIdx + 1) + '/' + group.length + ')' : alt;
        navBtns.forEach(function (b) { b.hidden = group.length < 2; });
      };
      shots.forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault(); lbOpener = a;
          var name = a.getAttribute('data-lightbox');
          group = shots.filter(function (x) { return x.getAttribute('data-lightbox') === name; });
          show(group.indexOf(a)); lb.showModal();
        });
      });
      lb.querySelector('.lb-prev').addEventListener('click', function () { show(lbIdx - 1); });
      lb.querySelector('.lb-next').addEventListener('click', function () { show(lbIdx + 1); });
      lb.querySelector('.lb-close').addEventListener('click', function () { lb.close(); });
      lb.addEventListener('click', function (e) { if (e.target === lb) lb.close(); });
      lb.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') show(lbIdx - 1);
        if (e.key === 'ArrowRight') show(lbIdx + 1);
      });
      lb.addEventListener('close', function () { lbImg.removeAttribute('src'); if (lbOpener) lbOpener.focus(); });
    }

    // Back to top: after the jump, keyboard focus starts again at the top of the page.
    // The default anchor jump would move focus itself, so the scroll is done here instead.
    if (toTop) toTop.addEventListener('click', function (e) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      var brand = document.querySelector('.top .brand');
      if (brand) brand.focus({ preventScroll: true });
    });
  })();
</script>
