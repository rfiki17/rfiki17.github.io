---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import { profile, type Lang } from '../data/cv';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pages that must not be indexed (404). Drops canonical, hreflang and social tags. */
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://rfiki17.github.io');
const enUrl = new URL('/', site).href;
const idUrl = new URL('/id/', site).href;
const canonical = lang === 'en' ? enUrl : idUrl;
const ogImage = new URL('/og.jpg', site).href;
const ogAlt = lang === 'en'
  ? 'Rifki Hidayatullah, QA / Software Test Engineer and IT GRC, holding the BRI GAMA IBCC 2026 grand finalist medal'
  : 'Rifki Hidayatullah, QA / Software Test Engineer dan IT GRC, memegang medali grand finalist BRI GAMA IBCC 2026';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role.en,
  worksFor: { '@type': 'Organization', name: 'PT Aero Systems Indonesia' },
  address: { '@type': 'PostalAddress', addressLocality: 'South Tangerang', addressCountry: 'ID' },
  memberOf: { '@type': 'Organization', name: 'ISACA Indonesia Chapter' },
  knowsAbout: ['Software testing', 'Test automation', 'IT governance', 'Risk management', 'Compliance'],
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  sameAs: [profile.linkedin],
  url: canonical,
  image: new URL('/img/portrait-1000.webp', site).href,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universitas Indonesia' },
    { '@type': 'CollegeOrUniversity', name: 'Universitas Multimedia Nusantara' },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FDFDFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0909" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="id" href={idUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
        <link rel="sitemap" href="/sitemap.xml" />
        <meta property="og:type" content="profile" />
        <meta property="og:site_name" content="Rifki Hidayatullah" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />
        <meta property="og:locale:alternate" content={lang === 'en' ? 'id_ID' : 'en_US'} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogAlt} />
        <meta property="profile:first_name" content="Rifki" />
        <meta property="profile:last_name" content="Hidayatullah" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogAlt} />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      </>
    )}
    <script is:inline>
      // Apply a saved theme before first paint. No saved choice means the OS setting decides.
      document.documentElement.classList.add('js');
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        function current() { return root.dataset.theme || (mq.matches ? 'dark' : 'light'); }
        function render() {
          // The button names the theme it switches to.
          var next = current() === 'dark' ? 'light' : 'dark';
          var label = btn.getAttribute(next === 'dark' ? 'data-label-dark' : 'data-label-light');
          btn.querySelector('.theme-text').textContent = label;
          btn.dataset.next = next;
        }
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          render();
        });
        mq.addEventListener('change', render);
        render();
      })();
    </script>
  </body>
</html>
